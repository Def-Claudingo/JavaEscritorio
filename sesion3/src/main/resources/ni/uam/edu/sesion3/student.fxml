<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" minHeight="300.0" minWidth="300.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.sesion3.StudentController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <Label fx:id="welcomeText" text="Univresidad Americana" textFill="#11bdf6">
      <font>
         <Font name="Arial Bold" size="18.0" />
      </font></Label>
   <Label text=" Registro de notas" />
   <Pane prefHeight="200.0" prefWidth="200.0">
      <children>
         <VBox prefHeight="200.0" prefWidth="250.0" spacing="5.0" style="-fx-border-color: #0099ab; -fx-border-radius: 10;">
            <children>
               <Label text="Nombre del Estudiante" />
               <TextField fx:id="txtName" prefHeight="25.0" prefWidth="202.0" />
               <Label text="Calificación" />
               <TextField fx:id="txtGrade" />
               <Button fx:id="btnSave" mnemonicParsing="false" onAction="#saveBtnClicked" text="Guardar" />
               <Label fx:id="lblAvg" text="Promedio: 0.0" />
            </children>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
         </VBox>
      </children>
   </Pane>
</VBox>
